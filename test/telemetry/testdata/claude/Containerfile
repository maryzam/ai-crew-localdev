FROM docker.io/library/node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
ARG CLAUDE_VERSION
RUN test -n "${CLAUDE_VERSION}" \
 && apt-get update \
 && apt-get install -y --no-install-recommends socat ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g "@anthropic-ai/claude-code@${CLAUDE_VERSION}" \
 && claude --version
COPY --chmod=0755 forward-model /usr/local/bin/forward-model
COPY image/ /
USER node
WORKDIR /workspaces/spike
